AGENT_FACTORY_ENVIRONMENT=development
AGENT_FACTORY_DATABASE_URL=sqlite+aiosqlite:///./data/agent_factory.db
AGENT_FACTORY_API_PREFIX=/api/v1
AGENT_FACTORY_MAX_REQUEST_BYTES=1048576
AGENT_FACTORY_DEFAULT_PAGE_SIZE=20
AGENT_FACTORY_MAX_PAGE_SIZE=100
AGENT_FACTORY_IDEMPOTENCY_TTL_SECONDS=86400
AGENT_FACTORY_SQLITE_BUSY_TIMEOUT_MS=5000
AGENT_FACTORY_AUDIT_LOG_LEVEL=INFO
AGENT_FACTORY_DATA_DIR=./data

# Replace this placeholder with a random secret of at least 32 characters.
# Without it, liveness remains available but readiness and business APIs fail closed.
AGENT_FACTORY_AUTH_TOKEN=replace-with-a-random-token-at-least-32-characters
AGENT_FACTORY_AUTH_SUBJECT=local-owner
AGENT_FACTORY_AUTH_ROLES='["admin"]'

# Default tests do not call an LLM. Add provider keys to a local .env only when
# an explicitly enabled live-model adapter is implemented.
# AGENT_FACTORY_MIGRATIONS_DIR may override the packaged SQL directory for
# migration development, but production should normally use the packaged files.
